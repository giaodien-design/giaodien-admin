// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model App {
  id            String    @id @default(cuid())
  name          String
  description   String?
  icon          String?   // URL icon/logo của app
  thumbnailUrl  String?   // Thumbnail image URL
  legacyCategory String?  // Legacy category field (deprecated, kept for data migration)
  categoryId    String?   // New category relation
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  platform      Platform  @default(IOS)
  brandColor    String?   // Màu chủ đạo của app (hex code)
  websiteUrl    String?
  slug          String    @unique // URL-friendly name: instagram, spotify, etc.
  sortOrder     Int       @default(0)
  
  // Relations
  screens       Screen[]
  
  // Metadata
  isPublished   Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([legacyCategory])
  @@index([categoryId])
  @@index([platform])
  @@index([slug])
  @@index([isPublished, createdAt(sort: Desc)])
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  apps        App[]
  
  @@index([slug])
}

model Flow {
  id          String   @id @default(cuid())
  name        String
  description String?
  sortOrder   Int      @default(0)
  
  // Relations
  screens     Screen[]
  
  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Screen {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String   // URL ảnh screenshot
  
  // Relations
  appId       String
  app         App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  flowId      String?
  flow        Flow?    @relation(fields: [flowId], references: [id], onDelete: SetNull)
  
  // Categorization
  screenType  String?  // Login, Home, Profile, Settings, Onboarding, Checkout, etc.
  tags        String[] // modal, form, list, card, navigation, animation, etc.
  
  // Engagement
  viewCount   Int      @default(0)
  likeCount   Int      @default(0)
  
  // Metadata
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([appId])
  @@index([flowId])
  @@index([screenType])
  @@index([viewCount])
  @@index([likeCount])
}

enum Platform {
  IOS
  ANDROID
  WEB
}
